{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osint-telegram-gateway-staging",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "TELEGRAM_CHAT_ID": "1664476273",
    "THREADS_PUBLISHING_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APPROVAL_COORDINATOR",
        "class_name": "ApprovalCoordinator"
      }
    ]
  },
  "exports": {
    "ApprovalCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
