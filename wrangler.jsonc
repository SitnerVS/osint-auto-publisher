
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osint-telegram-gateway-staging",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "EDITORIAL_DATA",
      "id": "aed1626849ee4364bc3b3d008db2916a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APPROVAL_COORDINATOR",
        "class_name": "ApprovalCoordinator"
      }
    ]
  },
  "exports": {
    "ApprovalCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
